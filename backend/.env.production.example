# ==============================================================================
# PVS SILK S — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Fill all REQUIRED fields before deploying to production.
# Never commit the actual production .env file into version control.

# Core Environment
ENVIRONMENT=production
DEBUG=false

# Security (REQUIRED: Generate with `openssl rand -hex 32`)
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ==============================================================================
# Database Configuration (REQUIRED: Production Managed PostgreSQL Connection)
# ==============================================================================
# 1. Application Runtime Connection (DATABASE_URL):
#    Note: asyncpg driver expects '?ssl=require' (our backend also auto-normalizes '?sslmode=require')
#    For Supabase, use the connection pooler URL with asyncpg:
#    - Session Mode (Port 5432):
#      DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[SECURE_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require
#    - Transaction Mode (Port 6543):
#      DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[SECURE_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[SECURE_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require

# 2. Alembic Migration Direct Connection (DIRECT_URL):
#    Alembic migrations require a direct/session connection on Port 5432 (never transaction pooler on port 6543):
DIRECT_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[SECURE_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require

# 3. Connection Pooler Configuration:
DB_POOL_MODE=session                     # 'session' | 'transaction' | omit for auto-detect from port (:6543)
DB_POOL_SIZE=5                           # Micro pool size suitable for Supabase Free tier
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# SECURITY NOTICE:
# DATABASE_URL, DIRECT_URL, and SECRET_KEY are server-side secrets.
# NEVER expose them to the browser or in NEXT_PUBLIC_* variables.

# Initial Super Admin (REQUIRED: Used by app/db/init_prod.py)
ADMIN_INITIAL_EMAIL=admin@pvssilks.com
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_16_CHARS

# CORS (REQUIRED: Only allow verified production domain and admin portal)
CORS_ORIGINS=https://pvssilks.com,https://admin.pvssilks.com

# Business Identity (REQUIRED: Actual PVS Silk S business details)
BUSINESS_NAME=PVS Silk S
BUSINESS_LEGAL_NAME=PVS Silk S Private Limited
BUSINESS_TAGLINE=Woven With Precision
BUSINESS_ADDRESS_LINE1=42, Weavers Colony
BUSINESS_CITY=Kanchipuram
BUSINESS_STATE=Tamil Nadu
BUSINESS_PINCODE=631501
BUSINESS_COUNTRY=India
BUSINESS_PHONE=+919842712345
BUSINESS_EMAIL=contact@pvssilks.com
BUSINESS_BILLING_EMAIL=billing@pvssilks.com
BUSINESS_WEBSITE=https://pvssilks.com

# Statutory GST Configuration (REQUIRED: Verified Tamil Nadu GSTIN)
GST_ENABLED=true
BUSINESS_GSTIN=33AAAAA0000A1Z5
BUSINESS_STATE_CODE=33
DEFAULT_GST_RATE=5.0
INVOICE_PREFIX=PVS/INV/2026-27/

# Bank Remittance Wire Details (REQUIRED: For official Tax Invoice generation)
BANK_NAME=State Bank of India
BANK_ACCOUNT_NAME=PVS Silk S Private Limited
BANK_ACCOUNT_NUMBER=REPLACE_WITH_REAL_ACCOUNT_NUMBER
BANK_IFSC=SBIN0000853
BANK_BRANCH=Kanchipuram Main Branch
BANK_UPI_ID=pvssilks@sbi
