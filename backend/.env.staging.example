# ==============================================================================
# PVS SILK S — BACKEND STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Use this template for the Staging verification environment.
# Never commit active credentials or passwords to source control.

# Core Environment
ENVIRONMENT=staging
DEBUG=false

# Security (Generate a strong 64-char key for Staging: `openssl rand -hex 32`)
SECRET_KEY=REPLACE_WITH_STAGING_64_CHAR_HEX_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (Staging isolated PostgreSQL instance)
DATABASE_URL=postgresql+asyncpg://pvs_staging_user:STAGING_DB_PASSWORD@staging-db.internal:5432/pvs_silks_staging

# Initial Super Admin (For initial test provisioning via app/db/init_prod.py)
ADMIN_INITIAL_EMAIL=staging-admin@pvssilks.test
ADMIN_INITIAL_PASSWORD=Staging_Admin_Secure_Pass_2026!

# CORS (Explicit Staging domain origins — no localhost or wildcards)
CORS_ORIGINS=https://staging.pvssilks.com,https://staging-admin.pvssilks.com

# Business Identity (Staging verification details)
BUSINESS_NAME=PVS Silk S (Staging)
BUSINESS_LEGAL_NAME=PVS Silk S Private Limited
BUSINESS_TAGLINE=Woven With Precision
BUSINESS_ADDRESS_LINE1=42, Weavers Colony
BUSINESS_ADDRESS_LINE2=Near Varadaraja Perumal Temple
BUSINESS_DISTRICT=Kanchipuram District
BUSINESS_CITY=Kanchipuram
BUSINESS_STATE=Tamil Nadu
BUSINESS_PINCODE=631501
BUSINESS_COUNTRY=India
BUSINESS_PHONE=+919842712345
BUSINESS_WHATSAPP=+919842712345
BUSINESS_EMAIL=staging@pvssilks.com
BUSINESS_BILLING_EMAIL=billing-staging@pvssilks.com
BUSINESS_WEBSITE=https://staging.pvssilks.com

# Statutory GST Configuration (Staging verified format)
GST_ENABLED=true
BUSINESS_GSTIN=33AAAAA1111A1Z1
BUSINESS_STATE_CODE=33
DEFAULT_GST_RATE=5.0
INVOICE_PREFIX=PVS/STG/2026-27/

# Bank Remittance Wire Details (Staging mock bank data for invoice testing)
BANK_NAME=State Bank of India
BANK_ACCOUNT_NAME=PVS Silk S Private Limited (Staging)
BANK_ACCOUNT_NUMBER=9999888877770001
BANK_IFSC=SBIN0000853
BANK_BRANCH=Kanchipuram Main Branch
