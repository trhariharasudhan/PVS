# ==============================================================================
# Customer design uploads (Custom Order Builder)
# ==============================================================================
# "supabase" = private Supabase Storage bucket (required in production)
# "local"    = files in LOCAL_UPLOAD_DIR (development only)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
SUPABASE_URL=
# Server-side secret. NEVER expose in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=custom-order-designs
