# ==============================================================================
# PVS SILK S — BACKEND STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Use this template for the Staging verification environment.
# Never commit active credentials or passwords to source control.

# Core Environment
ENVIRONMENT=staging
DEBUG=false

# Security (Generate a strong 64-char key for Staging: `openssl rand -hex 32`)
SECRET_KEY=REPLACE_WITH_STAGING_64_CHAR_HEX_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ==============================================================================
# Database Configuration (Staging Managed PostgreSQL Connection)
# ==============================================================================
# 1. Application Runtime Connection (DATABASE_URL):
#    Note: asyncpg driver expects '?ssl=require' (our backend also auto-normalizes '?sslmode=require')
#    For Supabase staging project:
#    - Session Mode (Port 5432):
#      DATABASE_URL=postgresql+asyncpg://postgres.[STAGING-PROJECT-REF]:[STAGING_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require
#    - Transaction Mode (Port 6543):
#      DATABASE_URL=postgresql+asyncpg://postgres.[STAGING-PROJECT-REF]:[STAGING_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres.[STAGING-PROJECT-REF]:[STAGING_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require

# 2. Alembic Migration Direct Connection (DIRECT_URL):
#    Alembic migrations require Port 5432 (never transaction pooler on port 6543):
DIRECT_URL=postgresql+asyncpg://postgres.[STAGING-PROJECT-REF]:[STAGING_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require

# 3. Connection Pooler Configuration:
DB_POOL_MODE=session                     # 'session' | 'transaction' | omit for auto-detect from port (:6543)
DB_POOL_SIZE=5                           # Micro pool size suitable for Supabase Free tier
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# SECURITY NOTICE:
# DATABASE_URL, DIRECT_URL, and SECRET_KEY are server-side secrets.
# NEVER expose them to the browser or in NEXT_PUBLIC_* variables.

# Initial Super Admin (For initial test provisioning via app/db/init_prod.py)
ADMIN_INITIAL_EMAIL=staging-admin@pvssilks.test
ADMIN_INITIAL_PASSWORD=Staging_Admin_Secure_Pass_2026!

# CORS (Explicit Staging domain origins — no localhost or wildcards)
CORS_ORIGINS=https://staging.pvssilks.com,https://staging-admin.pvssilks.com

# Business Identity (Staging verification details)
BUSINESS_NAME=PVS Silk S (Staging)
