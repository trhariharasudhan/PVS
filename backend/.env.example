# ==============================================================================
# PVS SILK S — BACKEND LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# Security & Secret Key (Change to a random 32+ character string in production)
SECRET_KEY=pvs-silks-insecure-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option A: Local PostgreSQL (Default for local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pvs_silks_db

# Option B: Supabase PostgreSQL (When connecting to managed Supabase instance)
# 1. Application Runtime Connection (DATABASE_URL):
#    Note: asyncpg driver expects '?ssl=require' (our backend also auto-normalizes '?sslmode=require')
#    - Session Pooler / Direct (Port 5432):
#      DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require
#    - Transaction Pooler (Port 6543):
#      DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
# 2. Alembic Migration Direct Connection (DIRECT_URL):
#    - Alembic DDL migrations require Port 5432 (never transaction pooler on port 6543):
#      DIRECT_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require
# 3. Connection Pooler Settings:
#    DB_POOL_MODE=session               # 'session' | 'transaction' | omit for auto-detect from port (:6543)
#    DB_POOL_SIZE=5                     # Micro pool size suitable for Supabase Free tier
#    DB_MAX_OVERFLOW=10
#    DB_POOL_TIMEOUT=30
#    DB_POOL_RECYCLE=1800
#
# SECURITY NOTICE:
# DATABASE_URL, DIRECT_URL, and SECRET_KEY are server-side secrets.
# NEVER expose them to the browser or in NEXT_PUBLIC_* variables.

# Initial Admin Credentials for Development
ADMIN_INITIAL_EMAIL=dev.admin@pvssilks.local
ADMIN_INITIAL_PASSWORD=pvs_demo_admin_2026

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,https://pvssilks.com

# Business Identity Configuration
BUSINESS_NAME=PVS Silk S
BUSINESS_LEGAL_NAME=PVS Silk S Private Limited
BUSINESS_TAGLINE=Woven With Precision
BUSINESS_ADDRESS_LINE1=42, Weavers Colony
BUSINESS_CITY=Kanchipuram
BUSINESS_STATE=Tamil Nadu
BUSINESS_PINCODE=631501
BUSINESS_COUNTRY=India
BUSINESS_PHONE=+91 98427 12345
BUSINESS_EMAIL=contact@pvssilks.com
BUSINESS_BILLING_EMAIL=billing@pvssilks.com
BUSINESS_WEBSITE=https://pvssilks.com

# Tax & Statutory Settings
GST_ENABLED=true
BUSINESS_GSTIN=33AAAAA0000A1Z5
BUSINESS_STATE_CODE=33
DEFAULT_GST_RATE=5.0
INVOICE_PREFIX=INV

# Bank Remittance Instructions for Invoice PDF & Settlements
# Fill with REAL verified values only. Empty = invoice shows "Bank details not configured".
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IFSC=
BANK_BRANCH=
BANK_UPI_ID=
